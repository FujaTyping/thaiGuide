    "SDG": {
        "title": "可持续发展目标 (SDGs)",
        "decs": "ThaiGuide 致力于支持联合国的可持续发展目标 (SDGs)。探索负责任的旅游如何为社区、环境和经济带来积极影响，以及我们如何通过各种举措为建设更美好的未来做出贡献。",
        "goal": {
            "1": {
                "title": "SDG 1：无贫穷",
                "decs": "通过鼓励游客参观鲜为人知的当地景点，该平台帮助为代表性不足的社区创造收入，并支持基层经济发展。"
            },
            "8": {
                "title": "SDG 8：体面工作和经济增长",
                "decs": "游戏化和数字奖励的使用促进了旅游业的参与度，通过增加知名度和机会，培养青年参与并赋权当地企业家。"
            },
            "9": {
                "title": "SDG 9：工业、创新和基础设施",
                "decs": "该创新利用人工智能和基于任务的旅游体验等新兴技术，创建更智能、更具互动性的旅游基础设施。"
            },
            "10": {
                "title": "SDG 10：减少不平等",
                "decs": "通过推广主流旅游景点以外的目的地，该平台有助于缩小城乡经济差距，并增加所有社区的旅游机会。"
            },
            "11": {
                "title": "SDG 11：可持续城市和社区",
                "decs": "该项目通过推广替代路线和体验，帮助减少热门目的地的过度拥挤，支持平衡和可持续的城市和社区发展。"
            }
        }
